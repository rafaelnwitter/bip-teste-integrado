# Credencial usada pelo PostgreSQL no Docker Compose.
POSTGRES_PASSWORD=change-me

# Configuração opcional para executar o backend localmente com outro banco.
# No Docker Compose, a URL, o usuário e o driver são definidos pelo serviço backend.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/backend_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# URL do remote entry do micro-frontend de benefícios.
# Aplicável ao build/servidor do frontend; o padrão é http://localhost:4201/remoteEntry.js.
MFE_BENEFICIOS_REMOTE=http://localhost:4201/remoteEntry.js
